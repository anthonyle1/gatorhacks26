# Optional: only needed for the legacy MongoDB endpoints.
MONGODB_URI=
MONGODB_DB=healthy_doomscrolling
MONGODB_SESSION_JOBS_ENABLED=false
YOUTUBE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TIMEOUT=300
# Legacy search endpoint only. Video assessment always disables web search.
OLLAMA_WEB_SEARCH_ENABLED=false
OLLAMA_API_KEY=
# Hosted backup after Ollama assessment/session classification fails. Keep this key server-side.
GEMINI_FALLBACK_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=60

# Reusable local evidence (SQLite stays authoritative when Redis is absent/offline).
REDIS_URL=
ANALYSIS_CACHE_ENABLED=true
ANALYSIS_CACHE_TTL=3600
ROBERTA_REVISION=3216a57f2a0d9c45a2e6c20157c20c49fb4bf9c7
# UF NaviGator is the default for video assessment and session topics.
# Create a Toolkit key with access to gemma-4-31b-it; keep the key backend-only.
ASSESSMENT_PROVIDER=navigator
TOPIC_PROVIDER=navigator
NAVIGATOR_TOOLKIT_API_KEY=
NAVIGATOR_BASE_URL=https://api.ai.it.ufl.edu/v1
NAVIGATOR_MODEL=gemma-4-31b-it
# Blank uses NAVIGATOR_MODEL for session topics as well.
NAVIGATOR_TOPIC_MODEL=
# auto tries schema -> JSON object -> schema-instructed text only on explicit unsupported-format errors.
NAVIGATOR_RESPONSE_FORMAT=auto
NAVIGATOR_TIMEOUT=45
NAVIGATOR_CONCURRENCY=2
# Optional alternative provider, selected with ASSESSMENT_PROVIDER=gemma.
GEMMA_ENDPOINT=https://api.together.xyz/v1/chat/completions
GEMMA_MODEL=google/gemma-4-31B-it
GEMMA_API_KEY=
GEMMA_TIMEOUT=45
GEMMA_CONCURRENCY=2
REVIEW_VIDEO_WORKERS=2
# Local audio is enabled by default; transcription failure disables it for that review.
AUDIO_ENABLED=true
AUDIO_DISABLE_ON_FAILURE=true
AUDIO_MAX_UPLOAD_BYTES=2000000
AUDIO_MAX_SECONDS=35
AUDIO_MAX_PENDING=100
AUDIO_EXPIRY_SECONDS=3600
AUDIO_FINALIZE_WAIT_SECONDS=10
ASR_MODEL=base.en
ASR_REVISION=3d3d5dee26484f91867d81cb899cfcf72b96be6c
ASR_MIN_SPEECH_SECONDS=1.5

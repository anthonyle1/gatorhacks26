
{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Prune",
  "version": "2.0",
  "description": "Track YouTube Shorts and Instagram Reels viewing activity.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.instagram.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.instagram.com/*"
      ],
      "js": ["collection-policy.js", "content.js"]
    }
  ],
  "action": {
    "default_title": "Open Prune"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
